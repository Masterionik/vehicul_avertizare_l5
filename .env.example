# Copy to .env and edit. The systemd service loads it with EnvironmentFile=.
# On a laptop, load it into the shell first:  set -a; . ./.env; set +a
# Plain KEY=value lines only (no quotes, no "export").

# --- Django -------------------------------------------------------------------------------
# 1 only for local development. With 0 a real DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=0
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Host names / IPs the dashboard is reachable under (comma separated). Add the Pi's name or IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],Pi4Master.local
DJANGO_TIME_ZONE=UTC

# --- Hardware / simulation ----------------------------------------------------------------
# 1 = no hardware needed (laptop), 0 = real GPIO and radios (Raspberry Pi).
MCD_SIMULATE=0
# Serial ports: leave empty to auto-detect through /dev/serial/by-id. Set them when two
# candidates are plugged in and the detection reports "ambiguous".
ZIGBEE_PORT=
MESHTASTIC_PORT=
# Set to 0 when only one vibration sensor (GPIO22) is fitted.
MCD_VIB2=1
# GPIO chip (number or name such as gpiochip4); leave empty to auto-detect the Pi header chip.
MCD_GPIOCHIP=

# --- Radio ----------------------------------------------------------------------------------
# Shared secret for the 4-byte alert signature. Use the SAME value on every node.
MESH_HMAC_KEY=change-me-too
# Optional fixed 32-bit node id of this node (decimal or 0x...). Derived from the host name if empty.
MESH_NODE_ID=

# --- Scripted remote vehicles V2 (Heltec e-ink) and V3 (Seeed XIAO) ---------------------------
# Serial port or TCP host of each extra board. Leave empty to simulate them (no radio used).
SIM_V2_PORT=
SIM_V2_HOST=
SIM_V3_PORT=
SIM_V3_HOST=

# --- Runtime --------------------------------------------------------------------------------
# 0 = the web app does not start the sensor / alert runtime thread.
NODE_AUTOSTART=1
