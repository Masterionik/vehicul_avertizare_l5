[Unit]
Description=Proximity warning kiosk browser (optional)
After=network-online.target proximity.service
Wants=proximity.service

[Service]
Type=simple
User=__USER__
Environment=DISPLAY=:0
Environment=XAUTHORITY=__USER_HOME__/.Xauthority
ExecStart=/bin/bash __APP_DIR__/scripts/kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
